<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="5dp"
    android:paddingBottom="5dp"
    android:paddingStart="0dp"
    android:paddingEnd="4dp">

    <!-- Time column -->
    <TextView
        android:id="@+id/item_time"
        android:layout_width="65dp"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:textColor="@color/widget_text_muted"
        android:fontFamily="sans-serif-medium"
        android:layout_marginEnd="8dp" />

    <!-- Left accent bar -->
    <ImageView
        android:id="@+id/item_accent"
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:background="@drawable/widget_accent_purple"
        android:layout_marginEnd="10dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/item_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/item_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="@color/widget_text_subtitle"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="1dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Status indicator -->
    <ImageView
        android:id="@+id/item_status_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/widget_dot_today"
        android:layout_marginStart="8dp"
        android:visibility="gone" />
</LinearLayout>
