<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp"
    android:background="@drawable/widget_background"
    android:elevation="2dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/widget_icon_book"
            android:layout_marginEnd="8dp"
            android:alpha="0.7" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Class Routine"
            android:textColor="#DE000000"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />
    </LinearLayout>

    <!-- Current class card — beautiful redesigned version -->
    <LinearLayout
        android:id="@+id/widget_current_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/widget_class_current_card_bg"
        android:padding="12dp"
        android:layout_marginBottom="10dp"
        android:visibility="gone">

        <!-- Green accent bar on left -->
        <View
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_class_accent_current"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Top row: NOW badge + timer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NOW"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:background="@drawable/badge_now_bg"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/widget_current_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#1E8E3E"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/widget_current_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#66000000"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Subject name -->
            <TextView
                android:id="@+id/widget_current_subject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#DE000000"
                android:textSize="15sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:layout_marginBottom="3dp" />

            <!-- Time row -->
            <TextView
                android:id="@+id/widget_current_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#99000000"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Today's schedule header -->
    <TextView
        android:id="@+id/widget_today_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TODAY'S SCHEDULE"
        android:textColor="#80000000"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:layout_marginBottom="6dp"
        android:visibility="gone" />

    <!-- Class list (rendered directly via RemoteViews.addView — no adapter,
         no service, no "Loading…" placeholder) -->
    <LinearLayout
        android:id="@+id/widget_class_list"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/widget_empty"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📚"
            android:textSize="24sp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/widget_empty_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No classes today"
            android:textColor="#99000000"
            android:textSize="13sp"
            android:textStyle="italic" />
    </LinearLayout>

    <!-- Updated timestamp -->
    <TextView
        android:id="@+id/widget_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#40000000"
        android:textSize="9sp"
        android:layout_marginTop="4dp" />

</LinearLayout>
