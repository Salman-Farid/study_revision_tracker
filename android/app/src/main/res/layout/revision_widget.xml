<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_background"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="4dp"
            android:layout_height="20dp"
            android:background="@drawable/widget_accent_blue"
            android:layout_marginEnd="10dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Revisions"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02" />

        <TextView
            android:id="@+id/widget_last_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="@color/widget_text_muted"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Stats chips row -->
    <LinearLayout
        android:id="@+id/widget_stats_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp"
        android:visibility="gone">

        <!-- Overdue chip (toggle button) -->
        <LinearLayout
            android:id="@+id/widget_overdue_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_badge_background"
            android:padding="6dp"
            android:layout_marginEnd="4dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/widget_dot_overdue"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/widget_overdue_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/widget_accent_red" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" missed"
                android:textSize="10sp"
                android:textColor="@color/widget_text_muted" />

            <ImageView
                android:id="@+id/widget_overdue_arrow"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/widget_accent_red"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Today chip (toggle button) -->
        <LinearLayout
            android:id="@+id/widget_today_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_badge_background"
            android:padding="6dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/widget_dot_today"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/widget_today_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/widget_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" today"
                android:textSize="10sp"
                android:textColor="@color/widget_text_muted" />

            <ImageView
                android:id="@+id/widget_today_arrow"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/widget_accent_blue"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Upcoming chip (toggle button) -->
        <LinearLayout
            android:id="@+id/widget_upcoming_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_badge_background"
            android:padding="6dp"
            android:layout_marginStart="4dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/widget_dot_today"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/widget_upcoming_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/widget_accent_green" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" soon"
                android:textSize="10sp"
                android:textColor="@color/widget_text_muted" />

            <ImageView
                android:id="@+id/widget_upcoming_arrow"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/widget_accent_green"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Overdue items section -->
    <LinearLayout
        android:id="@+id/widget_overdue_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- Today items section -->
    <LinearLayout
        android:id="@+id/widget_today_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- Upcoming items section -->
    <LinearLayout
        android:id="@+id/widget_upcoming_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- Legacy container (for backwards compat) -->
    <LinearLayout
        android:id="@+id/widget_items_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/widget_empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&#10003;"
            android:textSize="28sp"
            android:textColor="@color/widget_accent_green"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/widget_empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All caught up!"
            android:textSize="13sp"
            android:textColor="@color/widget_text_secondary"
            android:gravity="center" />
    </LinearLayout>
</LinearLayout>
