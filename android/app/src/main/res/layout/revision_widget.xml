<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp"
    android:background="@drawable/widget_bg_solid">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@mipmap/ic_launcher"
            android:layout_marginEnd="8dp"
            android:contentDescription="App icon" />

        <TextView
            android:id="@+id/widget_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Revision"
            android:textColor="#FF000000"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Toggle chips: selected tab is color-only (no bullet). Compact single-line labels. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/btn_today"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="TODAY (0)"
            android:textColor="#1A73E8"
            android:textSize="9sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:background="@drawable/btn_toggle_inactive"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/btn_missed"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="MISSED (0)"
            android:textColor="#80000000"
            android:textSize="9sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:background="@drawable/btn_toggle_inactive"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/btn_coming_up"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="UPCOMING (0)"
            android:textColor="#80000000"
            android:textSize="9sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:background="@drawable/btn_toggle_inactive" />
    </LinearLayout>

    <ListView
        android:id="@+id/widget_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:text="Nothing planned yet"
        android:textColor="#FF90A4AE"
        android:textSize="13sp"
        android:visibility="visible" />

</LinearLayout>
