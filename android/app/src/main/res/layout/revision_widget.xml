<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp"
    android:background="@drawable/widget_background"
    android:elevation="2dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@mipmap/ic_launcher"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/widget_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Revision"
            android:textColor="#DE000000"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />
    </LinearLayout>

    <!-- 3-way toggle: Today / Missed / Coming Up (scrollable row) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:fadeScrollbars="false"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_today"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minWidth="88dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="TODAY"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_toggle_active" />

            <TextView
                android:id="@+id/btn_missed"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minWidth="88dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="MISSED"
                android:textColor="#80000000"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_toggle_inactive" />

            <TextView
                android:id="@+id/btn_coming_up"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minWidth="88dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="COMING UP"
                android:textColor="#80000000"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/btn_toggle_inactive" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Status badge (hidden — empty message is enough) -->
    <TextView
        android:id="@+id/widget_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:background="@drawable/badge_overdue_bg"
        android:textColor="#DE000000"
        android:textSize="10sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp"
        android:visibility="gone" />

    <!-- Content rows (scrollable ListView via RemoteViewsAdapter) -->
    <ListView
        android:id="@+id/widget_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:clipToPadding="false"
        android:scrollbarStyle="outsideOverlay" />

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/widget_empty"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓"
            android:textColor="#66000000"
            android:textSize="24sp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/widget_empty_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All caught up!"
            android:textColor="#99000000"
            android:textSize="13sp"
            android:textStyle="italic" />
    </LinearLayout>

    <!-- Updated timestamp -->
    <TextView
        android:id="@+id/widget_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#40000000"
        android:textSize="9sp"
        android:layout_marginTop="6dp" />

</LinearLayout>
