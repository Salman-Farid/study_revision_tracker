<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp"
    android:background="@drawable/widget_background"
    android:elevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@mipmap/ic_launcher"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Daily Routine"
            android:textColor="#DE000000"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_current_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/widget_current_card_bg"
        android:padding="10dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOW"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="@drawable/badge_now_bg"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/widget_current_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#1A73E8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <!-- Chronometer updates every second (12:30 → 12:29…).
                 Must be Chronometer (not TextView) for RemoteViews.setChronometer. -->
            <Chronometer
                android:id="@+id/widget_current_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1E8E3E"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_current_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#DE000000"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <TextView
            android:id="@+id/widget_current_topic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#80000000"
            android:textSize="11sp"
            android:singleLine="true"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/widget_current_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#1A73E8"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_upcoming_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="UPCOMING"
        android:textColor="#80000000"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:layout_marginBottom="4dp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/widget_upcoming_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp" />

    <LinearLayout
        android:id="@+id/widget_empty"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_empty_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nothing to show"
            android:textColor="#99000000"
            android:textSize="13sp"
            android:textStyle="italic" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#40000000"
        android:textSize="9sp"
        android:layout_marginTop="4dp" />

</LinearLayout>
