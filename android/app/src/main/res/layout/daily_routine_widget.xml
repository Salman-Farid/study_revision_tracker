<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp"
    android:background="@drawable/widget_background"
    android:elevation="2dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@mipmap/ic_launcher"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Daily Routine"
            android:textColor="#DE000000"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />
    </LinearLayout>

    <!-- Current card (standalone, NOT in ListView) -->
    <LinearLayout
        android:id="@+id/widget_current_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/widget_current_card_bg"
        android:padding="10dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone">

        <!-- Timeline + real-time countdown timer row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOW"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="@drawable/badge_now_bg"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginEnd="6dp" />

            <!-- Timeline (start – end) of the current task, left side -->
            <TextView
                android:id="@+id/widget_current_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#1A73E8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <!-- Real-time countdown timer, right corner. Must be a Chronometer
                 view for RemoteViews.setChronometer (a TextView crashes apply()) -->
            <Chronometer
                android:id="@+id/widget_current_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1E8E3E"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_current_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#DE000000"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="1dp">

            <TextView
                android:id="@+id/widget_current_topic"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#99000000"
                android:textSize="11sp"
                android:singleLine="true" />

            <TextView
                android:id="@+id/widget_current_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#99000000"
                android:textSize="11sp"
                android:layout_marginStart="6dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- "Up next" header (outside ListView) -->
    <TextView
        android:id="@+id/widget_upcoming_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="UP NEXT"
        android:textColor="#80000000"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:layout_marginBottom="4dp"
        android:visibility="gone" />

    <!-- Upcoming items (scrollable ListView via RemoteViewsAdapter) -->
    <ListView
        android:id="@+id/widget_upcoming_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:clipToPadding="false"
        android:scrollbarStyle="outsideOverlay" />

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/widget_empty"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=":)"
            android:textColor="#66000000"
            android:textSize="24sp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/widget_empty_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No routine for today"
            android:textColor="#99000000"
            android:textSize="13sp"
            android:textStyle="italic" />
    </LinearLayout>

    <!-- Updated timestamp -->
    <TextView
        android:id="@+id/widget_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#40000000"
        android:textSize="9sp"
        android:layout_marginTop="4dp" />

</LinearLayout>
